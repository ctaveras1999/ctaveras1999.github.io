% Generated by cv/build.rb from _data/cv.yml and _data/pubs.yml. Edit those files (or this template),
% not the generated cv/build/cv.tex.
\documentclass[10pt,letterpaper]{article}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[left=0.65in,right=0.7in,top=0.71in,bottom=0.6in]{geometry}
\usepackage{array}
\usepackage{tabularx}
\usepackage{enumitem}
\usepackage{xcolor}
\usepackage{hyperref}

\definecolor{cvlink}{rgb}{0,0.6,0.73334}
\hypersetup{colorlinks=true, urlcolor=cvlink, linkcolor=cvlink,
  pdftitle={<%= tex(profile['name']) %> -- CV}, pdfauthor={<%= tex(profile['name']) %>}}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\tabcolsep}{0pt}

% One section = one row: bold label on the left (1.5in incl. gap), content on the right.
% Sections never split across pages.
\newcolumntype{L}{>{\raggedright\bfseries}p{96pt}}
\newenvironment{cvsection}[1]{%
  \tabularx{\textwidth}{@{}L@{\hspace{12pt}}X@{}}#1 &}{%
  \endtabularx\par\vspace{\sectionskip}}
\newlength{\sectionskip}\setlength{\sectionskip}{12pt}
\newlength{\entryskip}\setlength{\entryskip}{6pt}

% Bulleted lists inside a section
% Spacing measured from the original CV: one-line lists have 2pt between items, multi-line lists 5pt.
\newenvironment{cvitems}{\begin{itemize}[leftmargin=10pt, label=\textbullet, nosep, itemsep=2pt,
  before=\vspace{-\baselineskip}\vspace{5.1pt}]}{\end{itemize}}
\newenvironment{cvitemsspaced}{\begin{itemize}[leftmargin=10pt, label=\textbullet, nosep, itemsep=5pt,
  before=\vspace{-\baselineskip}\vspace{5.1pt}]}{\end{itemize}}
% A list line with its date flush right. Long text wraps before the date column instead of
% pushing the date onto a line of its own.
\newsavebox{\cvdatebox}
\newcommand{\dated}[2]{\sbox{\cvdatebox}{#2}%
  \begin{minipage}[t]{\dimexpr\linewidth-\wd\cvdatebox-1em\relax}\raggedright #1\end{minipage}%
  \hfill\usebox{\cvdatebox}}
\newenvironment{cvbullets}{\begin{itemize}[leftmargin=10pt, label=\textbullet, nosep, itemsep=1pt,
  before=\vspace{2pt}]}{\end{itemize}}

\begin{document}

{\centering{\Large\bfseries <%= tex(profile['name']) %>}\par}
\vspace{5pt}
\hspace*{2.8pt}\href{<%= url(profile['webpage']) %>}{Webpage}\hfill
\href{<%= url(profile['scholar']) %>}{Google Scholar}\hfill
\href{mailto:<%= url(profile['email']) %>}{Email}\hspace*{2.8pt}\par
\vspace{1pt}\hrule\vspace{7pt}

\begin{cvsection}{Research Interests}
<%= tex(profile['research_interests'].join(', ')) %>
\end{cvsection}
\vspace{-6pt}% the original has a smaller gap after this one-line section

\begin{cvsection}{Education}
<%- education.each_with_index do |e, i| -%>
<%= i.zero? ? '' : "\\vspace{\\entryskip}\n" %>\textbf{<%= md(e['where']) %>}<%= e['location'] ? ", \\textit{#{tex(e['location'])}}" : '' %>\hfill <%= tex(e['when'].sub('present', 'Present')) %>\newline
<%= md(e['what']) %><%- (e['details'] || []).each do |d| -%>\newline
<%= md(d) %><%- end -%>
\par
<%- end -%>
\end{cvsection}

\begin{cvsection}{Publications}
\begin{cvitemsspaced}
<%- pubs.each do |p| -%>
  \item <%= authors(p['authors']) %>. \textit{“<%= tex(p['title']) %>”}, <%= venue(p) %>
<%- end -%>
\end{cvitemsspaced}
\end{cvsection}

<%- unless presentations.empty? -%>
\begin{cvsection}{Presentations}
\begin{cvitemsspaced}
<%- presentations.each do |p, pr| -%>
  \item \textit{“<%= tex(p['title']) %>”} (<%= tex(pr['kind']) %>), <%= tex(pr['event_full']) %>, <%= pr['year'] %>
<%- end -%>
\end{cvitemsspaced}
\end{cvsection}

<%- end -%>
\begin{cvsection}{Awards}
\begin{cvitems}
<%- awards.each do |a| -%>
  \item \dated{<%= md(a['what']) %>}{<%= tex(a['when']) %>}
<%- end -%>
\end{cvitems}
\end{cvsection}

\begin{cvsection}{Conferences and Workshops}
\begin{cvitems}
<%- events.each do |e| -%>
  \item \dated{<%= md(e['what'], links: false) %>}{<%= tex(e['when']) %>}
<%- end -%>
\end{cvitems}
\end{cvsection}

\begin{cvsection}{Teaching}
<%- teaching.each_with_index do |t, i| -%>
<%= i.zero? ? '' : "\\vspace{\\entryskip}\n" %>\textbf{<%= md(t['what']) %>}<%= t['where'] ? ", \\textit{#{md(t['where'], links: false)}}" : '' %>\hfill <%= tex(t['when']) %>\par
<%- unless t['bullets'].empty? -%>
\begin{cvbullets}
<%- t['bullets'].each do |b| -%>
  \item <%= md(b) %>
<%- end -%>
\end{cvbullets}
<%- end -%>
<%- end -%>
\end{cvsection}

<%- unless employment.empty? -%>
\begin{cvsection}{Employment}
\begin{cvitems}
<%- employment.each do |e| -%>
  \item \dated{\textbf{<%= md(e['what']) %>}<%= e['where'] ? ", \\textit{#{md(e['where'], links: false)}}" : '' %>}{<%= tex(e['when']) %>}
<%- end -%>
\end{cvitems}
\end{cvsection}

<%- end -%>
<%- unless service.empty? -%>
\begin{cvsection}{Service}
\begin{cvitems}
<%- service.each do |e| -%>
  \item \dated{\textbf{<%= md(e['what']) %>}<%= e['where'] ? ", \\textit{#{md(e['where'], links: false)}}" : '' %>}{<%= tex(e['when']) %>}
<%- end -%>
\end{cvitems}
\end{cvsection}
<%- end -%>

\end{document}
